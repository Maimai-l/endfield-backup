  "libraries": [],
  "components": [
    {
      "name": "Avatar",
      "group": "内容展示",
      "summary": "头像，含图片、文字、占位、状态点与堆叠。"
    },
    {
      "name": "Banner",
      "group": "反馈与提示",
      "summary": "页面内提示条，常驻在相关内容上方，可关闭。"
    },
    {
      "name": "Breadcrumb",
      "group": "导航",
      "summary": "面包屑与路径，显示当前页面的位置。"
    },
    {
      "name": "Button",
      "group": "基础操作",
      "summary": "触发一个动作的按钮，分主要、强调、次要、幽灵、危险五种，高 24、32、40 三档。"
    },
    {
      "name": "Card",
      "group": "内容展示",
      "summary": "卡片：条目卡片、信息卡片、读数卡片、可交互卡片与可选卡片。"
    },
    {
      "name": "Checkbox",
      "group": "表单输入",
      "summary": "复选框，含未选、已选、半选、禁用。"
    },
    {
      "name": "ColorLine",
      "group": "装饰",
      "summary": "装饰色条：源站的粉、绿、黄三段色条，只作装饰，每屏至多一处。"
    },
    {
      "name": "Dialog",
      "group": "反馈与提示",
      "summary": "模态对话框，含普通确认与危险确认两类。"
    },
    {
      "name": "Divider",
      "group": "内容展示",
      "summary": "分隔线：横线、带标题分隔与竖线。"
    },
    {
      "name": "EmptyState",
      "group": "内容展示",
      "summary": "空状态：无数据、无搜索结果、无权限。"
    },
    {
      "name": "IconButton",
      "group": "基础操作",
      "summary": "只有图标的按钮，含方形、圆形关闭与返回、源站圆形翻页按钮三类。"
    },
    {
      "name": "InteractionStates",
      "group": "基础",
      "summary": "交互状态：默认、悬停、按下、聚焦、选中、禁用、加载、错误八种状态在各类控件上的表现。"
    },
    {
      "name": "Link",
      "group": "基础操作",
      "summary": "行内文字链接与独立的“查看全部”链接，始终带下划线。"
    },
    {
      "name": "List",
      "group": "内容展示",
      "summary": "列表与侧边菜单。"
    },
    {
      "name": "Loading",
      "group": "反馈与提示",
      "summary": "局部加载：旋转圆环与骨架块。"
    },
    {
      "name": "MetricBadge",
      "group": "内容展示",
      "summary": "指标徽章：名称、大号数值与说明按钮。"
    },
    {
      "name": "PageLoader",
      "group": "反馈与提示",
      "summary": "整页加载层，按源站首屏加载重建：纵向进度条与跟随读数，完成后黄色矩形自左向右覆盖再淡出。"
    },
    {
      "name": "Pagination",
      "group": "导航",
      "summary": "分页器：完整分页、简洁分页与源站翻页胶囊。"
    },
    {
      "name": "Progress",
      "group": "反馈与提示",
      "summary": "进度条，含确定进度、不确定进度、完成、错误、暂停。"
    },
    {
      "name": "QuotaPill",
      "group": "内容展示",
      "summary": "额度胶囊：当前值、上限与补充操作。"
    },
    {
      "name": "Radio",
      "group": "表单输入",
      "summary": "单选框，同组只能选一项。"
    },
    {
      "name": "SectionHeader",
      "group": "装饰",
      "summary": "区块标题：镂空条纹大字、黄色分区带与线稿插图，用于长页面的一级分区。"
    },
    {
      "name": "Select",
      "group": "表单输入",
      "summary": "下拉选择，含单选、可搜索、多选三种。"
    },
    {
      "name": "Sidebar",
      "group": "导航",
      "summary": "侧边导航，由标识区、导航项、分组标题、底部工具区四个元素组成，收起 64、展开 224。"
    },
    {
      "name": "Spacing",
      "group": "基础",
      "summary": "间距：阶梯、五个层级、新闻列表与工作页样例、错误与正确对比、页边距。"
    },
    {
      "name": "Switch",
      "group": "表单输入",
      "summary": "开关，用于立即生效的二元设置。"
    },
    {
      "name": "Table",
      "group": "内容展示",
      "summary": "数据表格：行选择、排序、标准与紧凑密度。"
    },
    {
      "name": "Tabs",
      "group": "导航",
      "summary": "标签页，含主标签栏、线型、区块、分段四种。"
    },
    {
      "name": "Tag",
      "group": "内容展示",
      "summary": "标签、状态标记与提醒角标。"
    },
    {
      "name": "TextArea",
      "group": "表单输入",
      "summary": "多行文本框，右下角显示字数。"
    },
    {
      "name": "TextField",
      "group": "表单输入",
      "summary": "单行文本框，标签在上，说明与错误在下。"
    },
    {
      "name": "Toast",
      "group": "反馈与提示",
      "summary": "操作结果的短暂反馈，出现在页面顶部居中，可带一个操作。"
    },
    {
      "name": "Tooltip",
      "group": "反馈与提示",
      "summary": "悬浮说明，解释图标按钮或缩写的含义。"
    },
    {
      "name": "TopBar",
      "group": "导航",
      "summary": "页面顶栏，槽位从左到右为标题区、搜索、操作、账户。"
    }
  ],
