 {
  "name": "Surface",
  "group": "基础",
  "height": 720,
  "style": "body{margin:0;background:var(--color-bg-page);color:var(--color-text-primary);font:14px/1.6 var(--font-body)}.stage{border:0;border-radius:0}.stage::before,.stage::after{display:none}body{padding-top:32px}.prov{position:absolute;top:12px;right:16px;z-index:5;display:inline-flex;align-items:center;height:20px;padding:0 8px;border-radius:var(--radius-sm);background:var(--color-checked);color:var(--color-on-checked);font:12px/1 var(--font-medium)}\n.sf{width:100%}\n.sf-hero{height:320px}\n.sf-copy{position:absolute;left:32px;top:32px;bottom:32px;width:min(296px,calc(100% - 64px));display:flex;flex-direction:column;align-items:flex-start}\n.sf-eyebrow{font:12px/16px var(--font-en);letter-spacing:.12em;text-transform:uppercase}\n.sf-title{margin:12px 0 0;font:28px/36px var(--font-bold)}\n.sf-text{margin:12px 0 0;font:14px/22px var(--font-body);color:var(--color-text-secondary)}\n.sf-copy .prog{width:100%;margin-top:24px}\n.sf-acts{display:flex;gap:16px;margin-top:auto}\n.sf-arch{height:296px;overflow:hidden}.sf-row:last-child{border-bottom:0}\n.sf-rows{position:absolute;left:32px;right:32px;top:56px;display:flex;flex-direction:column}\n.sf-row{display:flex;align-items:center;height:48px;border-bottom:1px solid var(--color-border-subtle);gap:32px}\n.sf-row:last-child{border-bottom:0}\n.sf-row .id{flex:none;width:96px;font:12px/1 var(--font-numeric);letter-spacing:.08em;color:var(--color-text-secondary)}\n.sf-row .t{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.sf-row .d{flex:none;font:12px/1 var(--font-numeric);color:var(--color-text-secondary)}\n.sf-bar{position:absolute;left:0;right:0;top:0;height:56px;border-radius:0;display:flex;align-items:center;gap:32px;padding:0 32px}\n.sf-bar b{flex:none;width:96px;font:16px/24px var(--font-medium)}\n.sf-bar span{position:relative;font:14px/56px var(--font-body);color:var(--color-text-secondary);white-space:nowrap}\n.sf-bar span[aria-current]{color:var(--color-text-primary)}\n.sf-bar span[aria-current]::after{content:\"\";position:absolute;left:0;right:0;bottom:0;height:2px;background:var(--y-300)}\n@container (max-width:480px){.sf-bar b{width:auto}.sf-bar{gap:24px}.sf-row .id{display:none}}\n.sf-arch{container-type:inline-size}\n"
