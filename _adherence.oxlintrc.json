{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/display/**",
              "components/feedback/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:SansRegular|SansMedium|SansBold|Gilroy-Light|Gilroy-Medium|Novecentosanswide-Medium|Novecentosanswide-DemiBold|Novecentosanswide-Bold|SpaceGrotesk))/i]",
        "message": "Font not provided by the design system. Available: SansRegular, SansMedium, SansBold, Gilroy-Light, Gilroy-Medium, Novecentosanswide-Medium, Novecentosanswide-DemiBold, Novecentosanswide-Bold, SpaceGrotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|active|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<AvatarChip> doesn't accept that prop. Declared props: image, active, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<BackButton> doesn't accept that prop. Declared props: children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<Button> variant must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CloseButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:onClick|style|key|ref|className|style|children)$/]",
        "message": "<CloseButton> doesn't accept that prop. Declared props: onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorDeco'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|style|key|ref|className|style|children)$/]",
        "message": "<ColorDeco> doesn't accept that prop. Declared props: kind, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorDeco'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:block|lattice|line)$/]",
        "message": "<ColorDeco> kind must be one of 'block' | 'lattice' | 'line'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Cta'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|horizontal|horizontalLabel|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Cta> doesn't accept that prop. Declared props: label, horizontal, horizontalLabel, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DividerBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:subtitle|title|width|style|key|ref|className|style|children)$/]",
        "message": "<DividerBand> doesn't accept that prop. Declared props: subtitle, title, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DownloadTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<DownloadTile> doesn't accept that prop. Declared props: children, icon, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DropdownTrigger'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<DropdownTrigger> doesn't accept that prop. Declared props: value, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HollowText'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|style|key|ref|className|style|children)$/]",
        "message": "<HollowText> doesn't accept that prop. Declared props: children, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HomeButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|white|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<HomeButton> doesn't accept that prop. Declared props: children, icon, white, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ItemIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|style|key|ref|className|style|children)$/]",
        "message": "<ItemIcon> doesn't accept that prop. Declared props: icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LabelTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|yellow|style|key|ref|className|style|children)$/]",
        "message": "<LabelTag> doesn't accept that prop. Declared props: label, value, yellow, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ListButton> doesn't accept that prop. Declared props: children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModalFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|small|onClose|children|style|key|ref|className|style|children)$/]",
        "message": "<ModalFrame> doesn't accept that prop. Declared props: title, small, onClose, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavSidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|activeIndex|expanded|height|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<NavSidebar> doesn't accept that prop. Declared props: items, activeIndex, expanded, height, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NoticeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|active|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<NoticeCard> doesn't accept that prop. Declared props: image, active, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|titleEn|brandLine|image|style|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: title, titleEn, brandLine, image, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute[name.name='image'] > Literal[value!=/^(?:bolt|pumper)$/]",
        "message": "<PageHeader> image must be one of 'bolt' | 'pumper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:dark|current|total|onPrev|onNext|prevDisabled|nextDisabled|style|key|ref|className|style|children)$/]",
        "message": "<Pagination> doesn't accept that prop. Declared props: dark, current, total, onPrev, onNext, prevDisabled, nextDisabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:onClick|style|key|ref|className|style|children)$/]",
        "message": "<PlayButton> doesn't accept that prop. Declared props: onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoundButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:direction|onClick|style|key|ref|className|style|children)$/]",
        "message": "<RoundButton> doesn't accept that prop. Declared props: direction, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoundButton'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:prev|next)$/]",
        "message": "<RoundButton> direction must be one of 'prev' | 'next'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:en|cn|dark|style|key|ref|className|style|children)$/]",
        "message": "<SectionTitle> doesn't accept that prop. Declared props: en, cn, dark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Selector'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|paging|dots|activeDot|onPrev|onNext|onDot|style|key|ref|className|style|children)$/]",
        "message": "<Selector> doesn't accept that prop. Declared props: name, paging, dots, activeDot, onPrev, onNext, onDot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShareButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|items|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ShareButton> doesn't accept that prop. Declared props: open, items, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|activeIndex|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: tabs, activeIndex, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TagDate'] > JSXAttribute > JSXIdentifier[name!=/^(?:tag|date|style|key|ref|className|style|children)$/]",
        "message": "<TagDate> doesn't accept that prop. Declared props: tag, date, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:subtitle|time|title|style|key|ref|className|style|children)$/]",
        "message": "<TitleBlock> doesn't accept that prop. Declared props: subtitle, time, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|visible|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: children, visible, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UtilityCapsule'] > JSXAttribute > JSXIdentifier[name!=/^(?:buttons|expanded|style|key|ref|className|style|children)$/]",
        "message": "<UtilityCapsule> doesn't accept that prop. Declared props: buttons, expanded, style."
      }
    ]
  },
